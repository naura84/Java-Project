<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.StudentsController" prefWidth="900" prefHeight="600">
    <children>
        <VBox layoutX="10.0" layoutY="10.0" spacing="10.0" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="10">
            <children>
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <children>
                        <Label text="Students" style="-fx-font-size:20px; -fx-font-weight:bold;" />
                        <Pane HBox.hgrow="ALWAYS" />
                        <TextField fx:id="searchField" promptText="Search by name or email" prefWidth="250" />
                        <Button fx:id="addBtn" text="Add Student" style="-fx-background-color:#0b1957; -fx-text-fill:white;" />
                    </children>
                </HBox>

                <TableView fx:id="studentsTable" prefHeight="520" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="60" />
                        <TableColumn fx:id="colStudentNumber" text="Student #" prefWidth="120" />
                        <TableColumn fx:id="colName" text="Name" prefWidth="180" />
                        <TableColumn fx:id="colEmail" text="Email" prefWidth="200" />
                        <TableColumn fx:id="colProgram" text="Program" prefWidth="120" />
                        <TableColumn fx:id="colLevel" text="Level" prefWidth="80" />
                        <TableColumn fx:id="colStatus" text="Status" prefWidth="80" />
                        <TableColumn fx:id="colActions" text="Actions" prefWidth="120" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </children>
</AnchorPane>
