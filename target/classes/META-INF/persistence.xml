<?xml version="1.0" encoding="UTF-8"?>
<!--
  persistence.xml pour JPA (Jakarta Persistence).
  - Remplacez les valeurs commentées ci-dessous (user, password, url) par vos informations de connexion.
  - `provider`: indique le fournisseur JPA (ex: Hibernate). Changez si vous utilisez un autre impl.
  - `hibernate.hbm2ddl.auto`: règle la génération/validation du schéma (validate/update/create/create-drop/none).
-->
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

  <persistence-unit name="gestion-scolaire" transaction-type="RESOURCE_LOCAL">

    <!-- Fournisseur JPA (modifiez si vous n'utilisez pas Hibernate) -->
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

    <!--
      Si votre provider ne scanne pas automatiquement les entités, listez-les ici:
      <class>models.User</class>
      <class>models.Etudiant</class>
      ...
    -->

    <properties>
      <!-- JDBC driver (leave as is for MySQL) -->
      <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>

      <!-- Database connection credentials (from .env file) -->
      <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/gestion_scolaire?serverTimezone=UTC&amp;useSSL=false"/>
      <property name="jakarta.persistence.jdbc.user" value="naura"/>
      <property name="jakarta.persistence.jdbc.password" value=")S]_7PCpUgkY)!36"/>

      <!-- Hibernate settings -->
      <property name="hibernate.dialect" value="org.hibernate.dialect.MySQL8Dialect"/>
      <property name="hibernate.hbm2ddl.auto" value="update"/>

      <property name="hibernate.show_sql" value="false"/>
      <property name="hibernate.format_sql" value="true"/>
    </properties>
  </persistence-unit>
</persistence>
