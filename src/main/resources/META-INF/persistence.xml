<?xml version="1.0" encoding="UTF-8"?>
<!--
  persistence.xml pour JPA (Jakarta Persistence).
  - Remplacez les valeurs commentées ci-dessous (user, password, url) par vos informations de connexion.
  - `provider`: indique le fournisseur JPA (ex: Hibernate). Changez si vous utilisez un autre impl.
  - `hibernate.hbm2ddl.auto`: règle la génération/validation du schéma (validate/update/create/create-drop/none).
-->
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

  <persistence-unit name="gestion-scolaire" transaction-type="RESOURCE_LOCAL">

    <!-- Fournisseur JPA (modifiez si vous n'utilisez pas Hibernate) -->
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

    <!--
      Si votre provider ne scanne pas automatiquement les entités, listez-les ici:
      <class>models.User</class>
      <class>models.Etudiant</class>
      ...
    -->

    <properties>
      <!-- JDBC driver (leave as is for MySQL) -->
      <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>

      <!-- The actual connection credentials are loaded from system properties. -->
      <!-- Use the provided `config.EnvLoader.load()` (call it before creating EntityManagerFactory)
           or pass JVM properties with -Djakarta.persistence.jdbc.url=... etc.
           This avoids hardcoding credentials in the XML. -->
      <property name="jakarta.persistence.jdbc.url" value="${jakarta.persistence.jdbc.url}"/>
      <property name="jakarta.persistence.jdbc.user" value="${jakarta.persistence.jdbc.user}"/>
      <property name="jakarta.persistence.jdbc.password" value="${jakarta.persistence.jdbc.password}"/>

      <!-- Hibernate settings (can also be set via .env/system props). Defaults provided after ':' -->
      <property name="hibernate.dialect" value="${hibernate.dialect:org.hibernate.dialect.MySQL8Dialect}"/>
      <property name="hibernate.hbm2ddl.auto" value="${hibernate.hbm2ddl.auto:validate}"/>

      <property name="hibernate.show_sql" value="${hibernate.show_sql:false}"/>
      <property name="hibernate.format_sql" value="${hibernate.format_sql:true}"/>
    </properties>
  </persistence-unit>
</persistence>
