# .env - Database connection template for gestion_scolaire
# WARNING: Do NOT commit real credentials to a public repo.

# JDBC URL for your MySQL server (change host, port, database as needed)
DB_URL=jdbc:mysql://localhost:3306/gestion_scolaire?serverTimezone=UTC&useSSL=false

# Database user and password
DB_USER=joyce
DB_PASSWORD=Admin123

# Optional: override Hibernate dialect and schema action
#HIBERNATE_DIALECT=org.hibernate.dialect.MySQL8Dialect
#HBM2DDL=validate

# Example usage: call config.EnvLoader.load() at application start to set System properties
